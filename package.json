{
  "name": "decky-gaugeshift",
  "version": "0.5.0",
  "description": "Decky plugin: per-device Maximum Game Resolution for Remote Play and Steam Link, restored when the stream ends.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm test && pnpm build"
  },
  "keywords": [
    "decky",
    "plugin",
    "steamos",
    "remote-play",
    "steam-link",
    "resolution",
    "gaugeshift"
  ],
  "author": "Mark",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "^3",
    "prettier": "^3",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
