{
  "name": "decky-gaugeshift",
  "version": "0.5.0",
  "description": "Decky plugin: per-device Maximum Game Resolution for Remote Play and Steam Link, restored when the stream ends.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm coverage && pnpm build && pnpm safety && pnpm audit",
    "safety": "python3 scripts/check_safety.py"
  },
  "keywords": [
    "decky",
    "plugin",
    "steamos",
    "remote-play",
    "steam-link",
    "resolution",
    "gaugeshift"
  ],
  "author": "Mark",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.5",
    "@rollup/rollup-linux-x64-musl": "^4.68.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.11.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.8",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.7.0",
    "tslib": "^2.9.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "overrides": {
      "glob": ">=14.0.2",
      "minimatch": ">=11.0.1"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
